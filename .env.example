# cogindex example environment. Copy to .env and fill in what you need.
# Never commit .env. Nothing in this file is required for `make test`.

# --- Cognee LLM/embeddings (only for real cognify runs & opt-in LLM tests) ---
# Any litellm-supported provider works; these are Cognee's own env vars.
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-5-mini
LLM_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openai/text-embedding-3-large
# Required when the embedding model is not in Cognee's dimension registry.
# Set this to the provider's actual vector width; do not guess.
# EMBEDDING_DIMENSIONS=3072

# --- Cognee storage isolation (recommended for local runs) ---
# By default Cognee writes databases inside its installed package directory.
# Point these at a workspace directory instead.
DATA_ROOT_DIRECTORY=./.cognee/data
SYSTEM_ROOT_DIRECTORY=./.cognee/system

# Cognee v1.4 enables multi-user backend access control by default.
# Single-user local setups may simplify by disabling it:
# ENABLE_BACKEND_ACCESS_CONTROL=false

# --- cogindex PostgreSQL advisory locks (optional, multi-worker deployments) ---
# POSTGRES_DSN=postgresql://user:password@localhost:5432/cogindex_locks

# --- Opt-in real-LLM integration tests ---
# COGINDEX_RUN_LLM_TESTS=1

# --- Deterministic no-LLM modes (tests, examples, benchmarks) ---
# MOCK_EMBEDDING=true is Cognee's own switch for deterministic embeddings;
# TELEMETRY_DISABLED=1 keeps runs network-free. The test suite and
# examples set both automatically in deterministic mode.
# MOCK_EMBEDDING=true
# TELEMETRY_DISABLED=1
